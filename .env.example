# Copy to .env.local for development. Never commit real secrets.

# MongoDB connection string. It must point at a replica set (Atlas always is; for local
# development run `pnpm db:dev`, which starts one and prints the URI below).
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
MONGODB_DB=store_app

# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# Public origin of the app (used for cookies and trusted origins).
BETTER_AUTH_URL=http://localhost:3000

# Optional. Error reporting to Sentry (errors only; see docs/DEPLOY.md section 15).
# SENTRY_DSN=

# Optional. After running pnpm db:indexes during a deploy, skip the start-up index check.
# SKIP_RUNTIME_INDEXES=1

# Optional. Per-device request limits per minute (defaults 600 and 180).
# RATE_LIMIT_READ_PER_MIN=600
# RATE_LIMIT_WRITE_PER_MIN=180

# Optional. Set to 1 at BUILD time to let people create shops themselves (closed by default).
# NEXT_PUBLIC_SIGNUP_ENABLED=1
