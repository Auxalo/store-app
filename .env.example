# Copy to .env.local for development. Never commit real secrets.

# MongoDB connection string. It must point at a replica set (Atlas always is; for local
# development run `pnpm db:dev`, which starts one and prints the URI below).
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
MONGODB_DB=store_app

# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# Public origin of the app (used for cookies and trusted origins).
BETTER_AUTH_URL=http://localhost:3000
