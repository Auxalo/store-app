{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!.data",
      "!src/components/ui",
      "!src/hooks/use-mobile.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/components/**", "src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "dexie-react-hooks": "Screens read through the hooks in @/data/hooks, so they work in both data modes.",
                  "@/db/local/db": "Screens read and write through @/data/hooks, so they work in both data modes."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/components/lock/**",
        "src/components/sync/**",
        "src/components/billing/**",
        "src/components/settings/**",
        "src/components/layout/user-menu.tsx",
        "src/components/setup/setup-table.tsx",
        "src/components/products/product-form-screen.tsx",
        "src/components/layout/offline-gate.tsx",
        "src/components/layout/sign-out.tsx",
        "src/components/layout/store-gate.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
